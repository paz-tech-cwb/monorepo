ADMIN_PORT=3010

# Dummy Firebase client config — avoids a client-side crash in admin-ui's
# Firebase Auth init. Real Google/Apple sign-in will not work against these
# fake values; this stack is for UI/API/DB validation, not auth provider
# testing. Never put real Firebase web config here.
NEXT_PUBLIC_FIREBASE_API_KEY=staging-local-fake-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=church-staging-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=church-staging-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=church-staging-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:staginglocal
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-STAGINGLOCAL
