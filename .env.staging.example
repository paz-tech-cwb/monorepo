# Local staging environment (Colima) — copy to .env.staging and adjust if needed.
# Never point these at production. No prod secrets belong in this file.

DB_USERNAME=church_staging
DB_PASSWORD=church_staging
DB_NAME=church_staging
DB_PORT=5433
DB_LOGGING=true

ACCESS_TOKEN_SECRET=staging_only_access_secret_change_me_32chars
REFRESH_TOKEN_SECRET=staging_only_refresh_secret_change_me_32chars
GOOGLE_CLIENT_ID=staging-client-id

