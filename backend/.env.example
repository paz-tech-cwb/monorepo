# Database (PostgreSQL)
# There are exactly two backend environments: production (deployed via Coolify,
# see docker-compose.yaml) and local/staging (this file). Every local checkout —
# including git worktrees — must point at the SAME shared local/staging Postgres
# container defined in docker-compose.staging.yaml (container: church_staging_postgres,
# host port 5433), started once via `docker compose -f docker-compose.staging.yaml up -d postgres`
# and left running. Do NOT spin up a second/alternate local Postgres container for
# app testing — running two local databases at once is what causes a worktree's
# backend to silently serve stale/wrong data on port 3001.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=church_staging
DB_PASSWORD=church_staging
DB_NAME=church_staging
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT (use 32+ character secrets in production)
ACCESS_TOKEN_SECRET=your_access_token_secret_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars

# Google OAuth (for social login verification)
GOOGLE_CLIENT_ID=

# Apple Sign-In (optional — only needed if Apple login is enabled)
# Bundle ID of your iOS app, e.g. com.yourchurch.app
APPLE_BUNDLE_ID=

# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Error monitoring (GlitchTip/Sentry-compatible; optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=paz-church-backend@local
SENTRY_SERVER_NAME=paz-church-backend
SENTRY_TRACES_SAMPLE_RATE=0

# Firebase Admin SDK (for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@pazchurch.com.br

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Meta Cloud API (WhatsApp)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
