<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy (pre-API 31) equivalent of data_extraction_rules.xml: excludes
  Chucker's network-inspector database from Android Auto Backup. Also excludes
  the entire files/ subtree (see data_extraction_rules.xml for why Chucker's
  spool files there can't be enumerated by name).

  Excluding the whole files/ domain also drops this app's DataStore/preferences
  files (e.g. files/datastore/paz_prefs.preferences_pb, which holds auth
  tokens) from Auto Backup. This is intentional, not an oversight: tokens
  should never be backed up in the first place. The known tradeoff is that
  users restoring to a new device will need to log in again rather than
  resuming a backed-up session.
-->
<full-backup-content>
    <exclude domain="database" path="chucker.db" />
    <exclude domain="database" path="chucker.db-wal" />
    <exclude domain="database" path="chucker.db-shm" />
    <exclude domain="database" path="chucker.db-journal" />
    <exclude domain="file" />
</full-backup-content>
